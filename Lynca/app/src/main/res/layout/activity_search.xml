<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F4F8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="48dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Buscar instalaciones"
                android:textColor="#111827"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="14dp"/>

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_search_bar"
                android:hint="Deporte, ciudad..."
                android:drawableStart="@android:drawable/ic_menu_search"
                android:drawablePadding="8dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:textSize="14sp"
                android:textColor="#111827"
                android:textColorHint="#6B7280"/>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:id="@+id/llSportChips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView android:id="@+id/chipTodos"
                        android:layout_width="wrap_content" android:layout_height="36dp"
                        android:text="Todos" android:gravity="center"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:background="@drawable/bg_chip_selected"
                        android:textColor="#FFFFFF" android:textSize="13sp"
                        android:textStyle="bold" android:layout_marginEnd="8dp"
                        android:clickable="true" android:focusable="true"/>

                    <TextView android:id="@+id/chipTenis"
                        android:layout_width="wrap_content" android:layout_height="36dp"
                        android:text="Tenis" android:gravity="center"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:background="@drawable/bg_chip_normal"
                        android:textColor="#111827" android:textSize="13sp"
                        android:layout_marginEnd="8dp"
                        android:clickable="true" android:focusable="true"/>

                    <TextView android:id="@+id/chipPadel"
                        android:layout_width="wrap_content" android:layout_height="36dp"
                        android:text="Padel" android:gravity="center"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:background="@drawable/bg_chip_normal"
                        android:textColor="#111827" android:textSize="13sp"
                        android:layout_marginEnd="8dp"
                        android:clickable="true" android:focusable="true"/>

                    <TextView android:id="@+id/chipFutbol"
                        android:layout_width="wrap_content" android:layout_height="36dp"
                        android:text="Futbol" android:gravity="center"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:background="@drawable/bg_chip_normal"
                        android:textColor="#111827" android:textSize="13sp"
                        android:layout_marginEnd="8dp"
                        android:clickable="true" android:focusable="true"/>

                    <TextView android:id="@+id/chipBaloncesto"
                        android:layout_width="wrap_content" android:layout_height="36dp"
                        android:text="Baloncesto" android:gravity="center"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:background="@drawable/bg_chip_normal"
                        android:textColor="#111827" android:textSize="13sp"
                        android:layout_marginEnd="8dp"
                        android:clickable="true" android:focusable="true"/>

                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>

        <!-- LISTA DE RESULTADOS -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvFacilities"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="16dp"
            android:clipToPadding="false"/>

        <!-- BOTTOM NAV -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:background="#FFFFFF"
            android:elevation="8dp"
            android:orientation="horizontal">

            <LinearLayout android:id="@+id/navHome"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:gravity="center"
                android:orientation="vertical"
                android:clickable="true" android:focusable="true">
                <ImageView android:layout_width="24dp" android:layout_height="24dp"
                    android:src="@android:drawable/ic_menu_compass"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Home" android:textSize="11sp" android:textColor="#6B7280"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/navSearch"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:gravity="center"
                android:orientation="vertical"
                android:clickable="true" android:focusable="true">
                <ImageView android:layout_width="24dp" android:layout_height="24dp"
                    android:src="@android:drawable/ic_menu_search"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Search" android:textSize="11sp"
                    android:textColor="#1E4DB7" android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/navBookings"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:gravity="center"
                android:orientation="vertical"
                android:clickable="true" android:focusable="true">
                <ImageView android:layout_width="24dp" android:layout_height="24dp"
                    android:src="@android:drawable/ic_menu_agenda"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Bookings" android:textSize="11sp" android:textColor="#6B7280"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/navProfile"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:gravity="center"
                android:orientation="vertical"
                android:clickable="true" android:focusable="true">
                <ImageView android:layout_width="24dp" android:layout_height="24dp"
                    android:src="@android:drawable/ic_menu_myplaces"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Profile" android:textSize="11sp" android:textColor="#6B7280"/>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>