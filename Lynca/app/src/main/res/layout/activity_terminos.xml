<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F2F4F8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E4DB7"
        android:orientation="horizontal"
        android:paddingTop="48dp"
        android:paddingBottom="16dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_media_previous"
            android:padding="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Términos y condiciones"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp"/>

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Última actualización: 1 de enero de 2025"
                android:textColor="#6B7280"
                android:textSize="13sp"
                android:layout_marginBottom="20dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. Aceptación de los términos"
                android:textColor="#1E4DB7"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Al descargar, instalar o utilizar la aplicación Lynca, el usuario acepta quedar vinculado por los presentes Términos y Condiciones. Si no está de acuerdo con alguno de estos términos, le rogamos que no utilice la aplicación."
                android:textColor="#374151"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.6"
                android:layout_marginBottom="20dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. Descripción del servicio"
                android:textColor="#1E4DB7"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Lynca es una plataforma digital desarrollada por Davante que permite a los usuarios buscar, consultar y reservar instalaciones deportivas. El servicio incluye la gestión de reservas, visualización de disponibilidad horaria y administración del perfil de usuario."
                android:textColor="#374151"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.6"
                android:layout_marginBottom="20dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3. Registro y cuenta de usuario"
                android:textColor="#1E4DB7"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Para utilizar los servicios de Lynca es necesario crear una cuenta proporcionando información veraz y actualizada. El usuario es responsable de mantener la confidencialidad de sus credenciales de acceso y de todas las actividades realizadas desde su cuenta."
                android:textColor="#374151"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.6"
                android:layout_marginBottom="20dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4. Política de reservas"
                android:textColor="#1E4DB7"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Las reservas realizadas a través de Lynca son vinculantes. El usuario puede cancelar una reserva de forma gratuita hasta 24 horas antes del inicio. Las cancelaciones tardías podrán estar sujetas a penalizaciones según la política de cada instalación."
                android:textColor="#374151"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.6"
                android:layout_marginBottom="20dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5. Protección de datos"
                android:textColor="#1E4DB7"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Lynca trata los datos personales de sus usuarios conforme al Reglamento General de Protección de Datos (RGPD) y la Ley Orgánica de Protección de Datos (LOPDGDD). Los datos recopilados se utilizan exclusivamente para la prestación del servicio y no serán cedidos a terceros sin consentimiento expreso."
                android:textColor="#374151"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.6"
                android:layout_marginBottom="20dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="6. Propiedad intelectual"
                android:textColor="#1E4DB7"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Todos los contenidos de la aplicación Lynca, incluyendo diseño, logotipos, textos e imágenes, son propiedad de Davante y están protegidos por las leyes de propiedad intelectual. Queda prohibida su reproducción total o parcial sin autorización expresa."
                android:textColor="#374151"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.6"
                android:layout_marginBottom="20dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="7. Limitación de responsabilidad"
                android:textColor="#1E4DB7"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Davante no se hace responsable de los daños o perjuicios derivados del uso incorrecto de la aplicación, de la indisponibilidad temporal del servicio o de la conducta de terceros. La empresa se reserva el derecho de modificar, suspender o interrumpir el servicio en cualquier momento."
                android:textColor="#374151"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.6"
                android:layout_marginBottom="20dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="8. Contacto"
                android:textColor="#1E4DB7"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Para cualquier consulta relacionada con estos términos, puede contactar con nosotros en:\n\nDavante S.L.\nCorreo: legal@lynca.com\nTeléfono: +34 900 123 456\nDirección: Calle Deportiva 42, 03440 Ibi, Alicante, España"
                android:textColor="#374151"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.6"
                android:layout_marginBottom="32dp"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>