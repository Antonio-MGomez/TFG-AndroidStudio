<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F7F7">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/layoutFooter"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="32dp">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/viewPagerHeader"
                android:layout_width="match_parent"
                android:layout_height="280dp"
                app:layout_constraintTop_toTopOf="parent"/>

            <TextView
                android:id="@+id/tvPistaNombre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:text="Nombre Pista"
                android:textColor="#1E4DB7"
                android:textSize="32sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/viewPagerHeader"/>

            <TextView
                android:id="@+id/tvDireccion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="4dp"
                android:text="📍 Dirección"
                android:textColor="#6B7280"
                android:textSize="13sp"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvPistaNombre"/>

            <LinearLayout
                android:id="@+id/layoutRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvDireccion">
                <ImageView android:layout_width="20dp" android:layout_height="20dp"
                    android:src="@android:drawable/btn_star_big_on"
                    app:tint="#F59E0B"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="4dp" android:text="4.8"
                    android:textColor="#000000" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="8dp" android:text="123 Reviews"
                    android:textColor="#6B7280"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutServices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_servicios_azul"
                android:orientation="horizontal"
                android:paddingTop="22dp"
                android:paddingBottom="22dp"
                app:layout_constraintTop_toBottomOf="@id/layoutRating">

                <TextView android:id="@+id/tvTag1"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:gravity="center"
                    android:text="🏀\nDeporte" android:textColor="#000000"
                    android:textSize="18sp" android:textStyle="bold"/>

                <TextView android:id="@+id/tvTag2"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:gravity="center"
                    android:text="💡\nIluminación" android:textColor="#000000"
                    android:textSize="18sp" android:textStyle="bold"/>

                <TextView android:id="@+id/tvTag3"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:gravity="center"
                    android:text="🚿\nVestuarios" android:textColor="#000000"
                    android:textSize="18sp" android:textStyle="bold"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvDescTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:text="Sobre esta pista"
                android:textColor="#000000"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/layoutServices"/>

            <TextView
                android:id="@+id/tvDescripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:text="Instalación deportiva de alta calidad."
                android:textColor="#000000"
                android:lineSpacingMultiplier="1.5"
                app:layout_constraintTop_toBottomOf="@id/tvDescTitle"/>

            <TextView
                android:id="@+id/tvReviewsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="32dp"
                android:text="Reviews"
                android:textColor="#000000"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvDescripcion"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:text="Ver todas"
                android:textColor="#1E4DB7"
                android:textStyle="bold"
                app:layout_constraintBaseline_toBaselineOf="@id/tvReviewsLabel"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- REVIEW 1 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardReview1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp" app:cardElevation="6dp"
                app:layout_constraintTop_toBottomOf="@id/tvReviewsLabel">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">
                    <ImageView android:id="@+id/imgUser1"
                        android:layout_width="55dp" android:layout_height="55dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/foto_review_1"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView android:id="@+id/tvUser1"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="MariaSport99" android:textColor="#000000"
                        android:textStyle="bold"
                        app:layout_constraintStart_toEndOf="@id/imgUser1"
                        app:layout_constraintTop_toTopOf="@id/imgUser1"/>
                    <LinearLayout android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/tvUser1">
                        <ImageView android:layout_width="16dp" android:layout_height="16dp"
                            android:src="@android:drawable/btn_star_big_on"
                            app:tint="#F59E0B"/>
                        <TextView android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp" android:text="4.9"
                            android:textColor="#000000" android:textStyle="bold"/>
                    </LinearLayout>
                    <TextView android:id="@+id/tvReview1Text"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Instalación impecable, muy bien mantenida."
                        android:textColor="#333333"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="@id/tvUser1"
                        app:layout_constraintTop_toBottomOf="@id/tvUser1"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <!-- REVIEW 2 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardReview2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp" app:cardElevation="6dp"
                app:layout_constraintTop_toBottomOf="@id/cardReview1">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">
                    <ImageView android:id="@+id/imgUser2"
                        android:layout_width="55dp" android:layout_height="55dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/foto_review_2"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView android:id="@+id/tvUser2"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="CarlosDeportivo" android:textColor="#000000"
                        android:textStyle="bold"
                        app:layout_constraintStart_toEndOf="@id/imgUser2"
                        app:layout_constraintTop_toTopOf="@id/imgUser2"/>
                    <LinearLayout android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/tvUser2">
                        <ImageView android:layout_width="16dp" android:layout_height="16dp"
                            android:src="@android:drawable/btn_star_big_on"
                            app:tint="#F59E0B"/>
                        <TextView android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp" android:text="4.7"
                            android:textColor="#000000" android:textStyle="bold"/>
                    </LinearLayout>
                    <TextView
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Muy buena iluminación y vestuarios limpios."
                        android:textColor="#333333"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="@id/tvUser2"
                        app:layout_constraintTop_toBottomOf="@id/tvUser2"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- FOOTER -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="20dp"
        android:padding="20dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNav">

        <TextView
            android:id="@+id/tvPrecioInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="€10 / hora"
            android:textColor="#111827"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <Button
            android:id="@+id/btnReservarInfo"
            android:layout_width="wrap_content"
            android:layout_height="55dp"
            android:paddingHorizontal="32dp"
            android:text="Reservar"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="#6B3FA0"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- BOTTOM NAV -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout android:id="@+id/navHome"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center"
            android:orientation="vertical"
            android:clickable="true" android:focusable="true">
            <ImageView android:layout_width="24dp" android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_compass"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/home" android:textSize="11sp"
                android:textColor="#6B7280"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/navSearch"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center"
            android:orientation="vertical"
            android:clickable="true" android:focusable="true">
            <ImageView android:layout_width="24dp" android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_search"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/search" android:textSize="11sp"
                android:textColor="#6B7280"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/navBookings"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center"
            android:orientation="vertical"
            android:clickable="true" android:focusable="true">
            <ImageView android:layout_width="24dp" android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_agenda"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/bookings" android:textSize="11sp"
                android:textColor="#6B7280"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/navProfile"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center"
            android:orientation="vertical"
            android:clickable="true" android:focusable="true">
            <ImageView android:layout_width="24dp" android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_myplaces"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/profile" android:textSize="11sp"
                android:textColor="#6B7280"/>
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>