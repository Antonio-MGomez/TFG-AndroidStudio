<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F2F4F8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E4DB7"
        android:orientation="vertical"
        android:paddingTop="48dp"
        android:paddingBottom="28dp"
        android:gravity="center">

        <ImageView
            android:id="@+id/imgPerfil"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:src="@drawable/foto_jose"
            android:scaleType="centerCrop"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/tvNombrePerfil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Usuario"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvEmailPerfil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="email@email.com"
            android:textColor="#99FFFFFF"
            android:textSize="14sp"/>

    </LinearLayout>

    <!-- ESTADÍSTICAS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:orientation="horizontal"
        android:padding="16dp"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:id="@+id/tvTotalReservas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#1E4DB7"
                android:textSize="28sp"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reservas_stat"
                android:textColor="#6B7280"
                android:textSize="13sp"/>
        </LinearLayout>

        <View android:layout_width="1dp" android:layout_height="50dp"
            android:background="#E9ECEF"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:id="@+id/tvDeporteFavorito"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎾"
                android:textSize="28sp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/favorito"
                android:textColor="#6B7280"
                android:textSize="13sp"/>
        </LinearLayout>

        <View android:layout_width="1dp" android:layout_height="50dp"
            android:background="#E9ECEF"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:id="@+id/tvMiembro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⭐"
                android:textSize="28sp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/miembro"
                android:textColor="#6B7280"
                android:textSize="13sp"/>
        </LinearLayout>

    </LinearLayout>

    <!-- CONTENIDO SCROLLABLE -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="80dp">

            <!-- MI CUENTA -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mi_cuenta"
                android:textColor="#6B7280"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:paddingBottom="8dp"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/btnMisReservas"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true" android:focusable="true">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@android:drawable/ic_menu_agenda"
                            android:layout_marginEnd="16dp"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/mis_reservas"
                            android:textColor="#111827" android:textSize="15sp"/>
                        <ImageView android:layout_width="20dp" android:layout_height="20dp"
                            android:src="@android:drawable/ic_media_next"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#F2F4F8" android:layout_marginStart="56dp"/>

                    <LinearLayout
                        android:id="@+id/btnEditarPerfil"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true" android:focusable="true">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@android:drawable/ic_menu_edit"
                            android:layout_marginEnd="16dp"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/editar_perfil"
                            android:textColor="#111827" android:textSize="15sp"/>
                        <ImageView android:layout_width="20dp" android:layout_height="20dp"
                            android:src="@android:drawable/ic_media_next"/>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- PREFERENCIAS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/preferencias"
                android:textColor="#6B7280"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingStart="20dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Modo nocturno -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@android:drawable/ic_menu_view"
                            android:layout_marginEnd="16dp"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/modo_nocturno"
                            android:textColor="#111827" android:textSize="15sp"/>
                        <Switch
                            android:id="@+id/switchModoNocturno"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="false"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#F2F4F8" android:layout_marginStart="56dp"/>

                    <!-- Notificaciones -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@android:drawable/ic_dialog_info"
                            android:layout_marginEnd="16dp"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/notificaciones"
                            android:textColor="#111827" android:textSize="15sp"/>
                        <Switch
                            android:id="@+id/switchNotificaciones"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#F2F4F8" android:layout_marginStart="56dp"/>

                    <!-- Idioma -->
                    <LinearLayout
                        android:id="@+id/btnIdioma"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true" android:focusable="true">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@android:drawable/ic_menu_compass"
                            android:layout_marginEnd="16dp"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/idioma"
                            android:textColor="#111827" android:textSize="15sp"/>
                        <TextView
                            android:id="@+id/tvIdiomaActual"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Español"
                            android:textColor="#6B7280" android:textSize="14sp"/>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- SOPORTE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/soporte"
                android:textColor="#6B7280"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingStart="20dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true" android:focusable="true">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@android:drawable/ic_menu_help"
                            android:layout_marginEnd="16dp"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/ayuda_soporte"
                            android:textColor="#111827" android:textSize="15sp"/>
                        <ImageView android:layout_width="20dp" android:layout_height="20dp"
                            android:src="@android:drawable/ic_media_next"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#F2F4F8" android:layout_marginStart="56dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true" android:focusable="true">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@android:drawable/ic_menu_info_details"
                            android:layout_marginEnd="16dp"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/terminos"
                            android:textColor="#111827" android:textSize="15sp"/>
                        <ImageView android:layout_width="20dp" android:layout_height="20dp"
                            android:src="@android:drawable/ic_media_next"/>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- CUENTA -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cuenta"
                android:textColor="#6B7280"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingStart="20dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/btnCerrarSesion"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true" android:focusable="true">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@android:drawable/ic_lock_power_off"
                            android:layout_marginEnd="16dp"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/cerrar_sesion"
                            android:textColor="#E53935"
                            android:textSize="15sp" android:textStyle="bold"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#F2F4F8" android:layout_marginStart="56dp"/>

                    <LinearLayout
                        android:id="@+id/btnEliminarCuenta"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true" android:focusable="true">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@android:drawable/ic_menu_delete"
                            android:layout_marginEnd="16dp"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/eliminar_cuenta"
                            android:textColor="#E53935" android:textSize="15sp"/>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- BOTTOM NAV -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:orientation="horizontal">

        <LinearLayout android:id="@+id/navHome"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center"
            android:orientation="vertical"
            android:clickable="true" android:focusable="true">
            <ImageView android:layout_width="24dp" android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_compass"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/home" android:textSize="11sp" android:textColor="#6B7280"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/navSearch"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center"
            android:orientation="vertical"
            android:clickable="true" android:focusable="true">
            <ImageView android:layout_width="24dp" android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_search"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/search" android:textSize="11sp" android:textColor="#6B7280"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/navBookings"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center"
            android:orientation="vertical"
            android:clickable="true" android:focusable="true">
            <ImageView android:layout_width="24dp" android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_agenda"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/bookings" android:textSize="11sp" android:textColor="#6B7280"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/navProfile"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center"
            android:orientation="vertical"
            android:clickable="true" android:focusable="true">
            <ImageView android:layout_width="24dp" android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_myplaces"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/profile" android:textSize="11sp"
                android:textColor="#1E4DB7" android:textStyle="bold"/>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>