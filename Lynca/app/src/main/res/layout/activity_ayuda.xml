<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F2F4F8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E4DB7"
        android:orientation="horizontal"
        android:paddingTop="48dp"
        android:paddingBottom="16dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_media_previous"
            android:padding="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Ayuda y soporte"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp"/>

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- BUSCADOR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#1E4DB7"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="#FFFFFF"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@android:drawable/ic_menu_search"/>

                    <EditText
                        android:id="@+id/etBuscarAyuda"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:hint="¿En qué podemos ayudarte?"
                        android:textColor="#111827"
                        android:textColorHint="#6B7280"
                        android:textSize="14sp"
                        android:background="@null"
                        android:inputType="text"
                        android:imeOptions="actionSearch"/>
                </LinearLayout>
            </LinearLayout>

            <!-- PREGUNTAS FRECUENTES -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PREGUNTAS FRECUENTES"
                android:textColor="#6B7280"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:paddingBottom="8dp"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- FAQ 1 -->
                    <LinearLayout
                        android:id="@+id/faq1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true" android:focusable="true">
                        <LinearLayout android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <TextView android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="¿Cómo cancelo una reserva?"
                                android:textColor="#111827"
                                android:textSize="15sp" android:textStyle="bold"/>
                            <ImageView android:id="@+id/iconFaq1"
                                android:layout_width="20dp" android:layout_height="20dp"
                                android:src="@android:drawable/arrow_down_float"/>
                        </LinearLayout>
                        <TextView android:id="@+id/textFaq1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Ve a tu perfil → Mis reservas → selecciona la reserva y pulsa Cancelar. Las cancelaciones son gratuitas hasta 24h antes."
                            android:textColor="#6B7280" android:textSize="14sp"
                            android:layout_marginTop="8dp"
                            android:visibility="gone"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#F2F4F8"/>

                    <!-- FAQ 2 -->
                    <LinearLayout
                        android:id="@+id/faq2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true" android:focusable="true">
                        <LinearLayout android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <TextView android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="¿Cómo cambio mi contraseña?"
                                android:textColor="#111827"
                                android:textSize="15sp" android:textStyle="bold"/>
                            <ImageView android:id="@+id/iconFaq2"
                                android:layout_width="20dp" android:layout_height="20dp"
                                android:src="@android:drawable/arrow_down_float"/>
                        </LinearLayout>
                        <TextView android:id="@+id/textFaq2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Ve a Perfil → Editar perfil → introduce tu nueva contraseña y confírmala. Mínimo 6 caracteres."
                            android:textColor="#6B7280" android:textSize="14sp"
                            android:layout_marginTop="8dp"
                            android:visibility="gone"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#F2F4F8"/>

                    <!-- FAQ 3 -->
                    <LinearLayout
                        android:id="@+id/faq3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true" android:focusable="true">
                        <LinearLayout android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <TextView android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="¿Cómo reservo una pista?"
                                android:textColor="#111827"
                                android:textSize="15sp" android:textStyle="bold"/>
                            <ImageView android:id="@+id/iconFaq3"
                                android:layout_width="20dp" android:layout_height="20dp"
                                android:src="@android:drawable/arrow_down_float"/>
                        </LinearLayout>
                        <TextView android:id="@+id/textFaq3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Busca la pista en el apartado Buscar, selecciónala, elige la fecha y hora disponible y pulsa Reservar."
                            android:textColor="#6B7280" android:textSize="14sp"
                            android:layout_marginTop="8dp"
                            android:visibility="gone"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#F2F4F8"/>

                    <!-- FAQ 4 -->
                    <LinearLayout
                        android:id="@+id/faq4"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true" android:focusable="true">
                        <LinearLayout android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <TextView android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="¿Puedo cambiar el idioma?"
                                android:textColor="#111827"
                                android:textSize="15sp" android:textStyle="bold"/>
                            <ImageView android:id="@+id/iconFaq4"
                                android:layout_width="20dp" android:layout_height="20dp"
                                android:src="@android:drawable/arrow_down_float"/>
                        </LinearLayout>
                        <TextView android:id="@+id/textFaq4"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Sí. Ve a Perfil → Idioma y selecciona entre Español, English, Català, Euskera o Galego."
                            android:textColor="#6B7280" android:textSize="14sp"
                            android:layout_marginTop="8dp"
                            android:visibility="gone"/>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- CONTACTO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONTACTA CON NOSOTROS"
                android:textColor="#6B7280"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingStart="20dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/btnEmail"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true" android:focusable="true">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@android:drawable/ic_dialog_email"
                            android:layout_marginEnd="16dp"/>
                        <LinearLayout android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Envíanos un email"
                                android:textColor="#111827" android:textSize="15sp"/>
                            <TextView android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="soporte@lynca.com"
                                android:textColor="#6B7280" android:textSize="13sp"/>
                        </LinearLayout>
                        <ImageView android:layout_width="20dp" android:layout_height="20dp"
                            android:src="@android:drawable/ic_media_next"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#F2F4F8" android:layout_marginStart="56dp"/>

                    <LinearLayout
                        android:id="@+id/btnWhatsapp"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true" android:focusable="true">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@android:drawable/ic_menu_call"
                            android:layout_marginEnd="16dp"/>
                        <LinearLayout android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Teléfono"
                                android:textColor="#111827" android:textSize="15sp"/>
                            <TextView android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="+34 900 123 456"
                                android:textColor="#6B7280" android:textSize="13sp"/>
                        </LinearLayout>
                        <ImageView android:layout_width="20dp" android:layout_height="20dp"
                            android:src="@android:drawable/ic_media_next"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#F2F4F8" android:layout_marginStart="56dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@android:drawable/ic_menu_recent_history"
                            android:layout_marginEnd="16dp"/>
                        <LinearLayout android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Horario de atención"
                                android:textColor="#111827" android:textSize="15sp"/>
                            <TextView android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Lun - Vie: 9:00 - 18:00"
                                android:textColor="#6B7280" android:textSize="13sp"/>
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Lynca v1.0.0 · Davante © 2025"
                android:textColor="#9CA3AF"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>